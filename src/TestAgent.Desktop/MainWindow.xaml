<Window x:Class="TestAgent.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="K.netagentV0.1" Width="1180" Height="760" MinWidth="900" MinHeight="600" Background="#111827" Foreground="#E5E7EB"><Window.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/></Window.Resources>
 <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#1F2937" CornerRadius="8" Padding="10"><DockPanel><StackPanel DockPanel.Dock="Top"><Button Content="＋ 新会话" Command="{Binding NewSessionCommand}"/><Button Content="清空当前会话" Command="{Binding ClearSessionCommand}" Margin="0,6,0,10"/></StackPanel><ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" DisplayMemberPath="Title" Background="#1F2937" Foreground="White" BorderThickness="0"/></DockPanel></Border>
  <Grid Grid.Column="1" Margin="12,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox ItemsSource="{Binding Messages}" Background="#111827" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Border Background="#1F2937" CornerRadius="8" Padding="10" Margin="0,4"><StackPanel><TextBlock Text="{Binding Role}" Foreground="#A78BFA" FontWeight="Bold"/><TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="#F3F4F6"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Row="1" Background="#1F2937" CornerRadius="8" Padding="10" Margin="0,4" Visibility="{Binding HasStreamingContent, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="Assistant" Foreground="#A78BFA" FontWeight="Bold"/><TextBlock Text="{Binding StreamingContent}" TextWrapping="Wrap" Foreground="#F3F4F6"/></StackPanel></Border></Grid>
   <Expander Grid.Row="1" Header="推理过程" IsExpanded="False" Visibility="{Binding HasReasoning, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding Reasoning}" TextWrapping="Wrap" Foreground="#9CA3AF" Margin="8"/></Expander>
   <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PromptBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" KeyDown="PromptBox_KeyDown"/><StackPanel Grid.Column="1" Margin="8,0,0,0"><Button Content="发送" Command="{Binding SendCommand}" Width="72" Height="32"/><Button Content="停止" Command="{Binding StopCommand}" Width="72" Height="32" Margin="0,6,0,0"/></StackPanel></Grid>
  </Grid>
   <TabControl Grid.Column="2" Background="#1F2937" Foreground="White"><TabItem Header="设置"><ScrollViewer><StackPanel Margin="12"><TextBlock Text="Provider"/><ComboBox ItemsSource="{Binding ProviderIds}" SelectedItem="{Binding ProviderId}" Margin="0,4,0,10"/><TextBlock Text="Endpoint"/><TextBox Text="{Binding Endpoint}" Margin="0,4,0,10"/><TextBlock Text="Model"/><TextBox Text="{Binding Model}" Margin="0,4,0,10"/><TextBlock Text="API Key（安全保存）"/><PasswordBox x:Name="ApiKeyBox" Margin="0,4,0,10"/><TextBlock Text="Max Tokens"/><TextBox Text="{Binding MaxTokens}" Margin="0,4,0,10"/><TextBlock Text="Timeout 秒"/><TextBox Text="{Binding TimeoutSeconds}" Margin="0,4,0,10"/><CheckBox Content="回答完成后自审一次" IsChecked="{Binding SelfReviewEnabled}" Margin="0,4,0,10"/><Button Content="保存设置" Click="SaveSettings_Click"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#93C5FD"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="记忆"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox ItemsSource="{Binding Memories}" SelectedItem="{Binding SelectedMemory}" DisplayMemberPath="Name"/><StackPanel Grid.Row="1"><TextBox Text="{Binding MemoryName}" Margin="0,8,0,4"/><TextBox Text="{Binding MemoryContent}" AcceptsReturn="True" Height="90" TextWrapping="Wrap"/><TextBlock Text="记忆范围"/><ComboBox ItemsSource="{Binding MemoryScopes}" SelectedItem="{Binding MemoryScope}" Margin="0,3"/><TextBox Text="{Binding MemoryScopeId}" ToolTip="Session 可留空使用当前聊天；Project 填工作区相对路径。User 留空。"/><CheckBox Content="启用" IsChecked="{Binding MemoryEnabled}" Margin="0,5"/><StackPanel Orientation="Horizontal"><Button Content="保存" Command="{Binding SaveMemoryCommand}" Width="70"/><Button Content="删除" Command="{Binding DeleteMemoryCommand}" Width="70" Margin="6,0,0,0"/></StackPanel></StackPanel></Grid></TabItem>
   <TabItem Header="工具会话"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="每个工具一个隔离会话" FontWeight="Bold" FontSize="15"/><TextBlock Text="这些会话只保存该工具的状态、成功参数形状和失败摘要，不是独立 Agent，也不会自行调用模型。" TextWrapping="Wrap" Foreground="#93C5FD" Margin="0,4,0,6"/><TextBlock Text="{Binding ToolSessionStatus}" TextWrapping="Wrap" Foreground="#FBBF24" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal"><Button Content="刷新当前会话" Command="{Binding RefreshToolSessionsCommand}"/><Button Content="已检查并解除中断" Command="{Binding AcknowledgeToolSessionsCommand}" Margin="6,0,0,0" ToolTip="只在 NeedsReview 时使用；请先检查上次写入或命令结果。"/></StackPanel></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding ToolSessions}" Margin="0,8,0,0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#374151" BorderThickness="0,0,0,1" Padding="4"><StackPanel><TextBlock><Run Text="{Binding ToolName}" FontWeight="Bold"/><Run Text=" · "/><Run Text="{Binding State}" Foreground="#FBBF24"/></TextBlock><TextBlock><Run Text="调用 "/><Run Text="{Binding TotalCalls}"/><Run Text=" · 成功率 "/><Run Text="{Binding SuccessRate}"/></TextBlock><TextBlock Text="{Binding LastSummary}" TextWrapping="Wrap" Foreground="#D1D5DB"/><TextBlock Text="{Binding LastError}" TextWrapping="Wrap" Foreground="#F87171"/><TextBlock Text="{Binding LastSuccessfulStrategy}" TextWrapping="Wrap" FontSize="10" Foreground="#9CA3AF"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
   <TabItem Header="长任务"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="单 Agent 任务分治" FontWeight="Bold" FontSize="15"/><TextBlock Text="先生成最多 12 节点的计划；审阅批准后，同一个 Agent 按依赖顺序执行，每个节点只获得相关路径与直接依赖摘要。" TextWrapping="Wrap" Foreground="#93C5FD" Margin="0,5,0,8"/><TextBox Text="{Binding TaskGoal, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="82" TextWrapping="Wrap" ToolTip="输入完整任务目标"/><StackPanel Orientation="Horizontal" Margin="0,6"><Button Content="生成计划" Command="{Binding CreateTaskPlanCommand}" Width="76"/><Button Content="刷新" Command="{Binding RefreshTaskPlansCommand}" Width="64" Margin="6,0,0,0"/></StackPanel></StackPanel><ComboBox Grid.Row="1" ItemsSource="{Binding TaskWorkflows}" SelectedItem="{Binding SelectedTaskWorkflow}" DisplayMemberPath="Plan.Goal" Margin="0,2,0,6"/><ListBox Grid.Row="2" ItemsSource="{Binding TaskNodes}" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#374151" BorderThickness="0,0,0,1" Padding="4"><StackPanel><TextBlock><Run Text="{Binding Id}"/><Run Text=" · "/><Run Text="{Binding Title}" FontWeight="Bold"/></TextBlock><TextBlock><Run Text="{Binding Mode}" Foreground="#A78BFA"/><Run Text=" · "/><Run Text="{Binding Status}" Foreground="#FBBF24"/></TextBlock><TextBlock Text="{Binding RelevantPaths}" TextWrapping="Wrap" Foreground="#9CA3AF"/><TextBlock Text="{Binding AcceptanceCriteria}" TextWrapping="Wrap" FontSize="11"/><TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#F87171"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="3"><TextBlock Text="{Binding TaskSummary}" TextWrapping="Wrap" Margin="0,6"/><CheckBox Content="我已审阅节点、依赖、相关路径和验收条件" IsChecked="{Binding TaskPlanApproved}"/><Button Content="执行 / 恢复计划" Command="{Binding RunTaskPlanCommand}" Margin="0,6,0,0"/><Button Content="已检查工作区并允许重试" Command="{Binding ReviewAndRetryTaskCommand}" Margin="0,4,0,0" ToolTip="仅在 NeedsReview 时使用；请先人工确认上次写入结果。"/></StackPanel></Grid></TabItem>
   <TabItem Header="自迭代"><ScrollViewer><StackPanel Margin="10"><TextBlock Text="受控代码迭代" FontWeight="Bold" FontSize="15"/><TextBlock Text="读取 iteration-guides 中的指引。提案只在隔离副本验证，勾选批准后才修改源码；失败自动回滚。" TextWrapping="Wrap" Foreground="#FBBF24" Margin="0,5,0,10"/><ComboBox ItemsSource="{Binding IterationGuides}" SelectedItem="{Binding SelectedIterationGuide}" DisplayMemberPath="Title"/><Button Content="生成并验证提案" Command="{Binding GenerateIterationCommand}" Margin="0,8,0,4"/><TextBlock Text="{Binding IterationSummary}" TextWrapping="Wrap"/><TextBlock Text="{Binding IterationFiles}" TextWrapping="Wrap" Foreground="#93C5FD" Margin="0,5"/><TextBox Text="{Binding IterationPreview}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" Height="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/><TextBlock Text="{Binding IterationValidation}" TextWrapping="Wrap" MaxHeight="180"/><CheckBox Content="我已审阅上方完整原文/新文并批准应用" IsChecked="{Binding IterationApproved}" Margin="0,8"/><Button Content="应用已批准提案" Command="{Binding ApplyIterationCommand}"/></StackPanel></ScrollViewer></TabItem></TabControl>
 </Grid>
</Window>
