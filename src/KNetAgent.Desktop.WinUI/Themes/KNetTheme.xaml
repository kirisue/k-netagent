<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="KNetBackgroundColor">#0D0E11</Color>
    <Color x:Key="KNetRailColor">#121419</Color>
    <Color x:Key="KNetSurfaceColor">#17191F</Color>
    <Color x:Key="KNetSurfaceElevatedColor">#1C1F26</Color>
    <Color x:Key="KNetBorderColor">#2A2E37</Color>
    <Color x:Key="KNetTextPrimaryColor">#F3F4F6</Color>
    <Color x:Key="KNetTextSecondaryColor">#9CA3AF</Color>
    <Color x:Key="KNetAccentColor">#D6FF3F</Color>
    <Color x:Key="KNetAccentMutedColor">#263116</Color>
    <Color x:Key="KNetDangerColor">#FF7B72</Color>

    <SolidColorBrush x:Key="KNetBackgroundBrush" Color="{StaticResource KNetBackgroundColor}" />
    <SolidColorBrush x:Key="KNetRailBrush" Color="{StaticResource KNetRailColor}" />
    <SolidColorBrush x:Key="KNetSurfaceBrush" Color="{StaticResource KNetSurfaceColor}" />
    <SolidColorBrush x:Key="KNetSurfaceElevatedBrush" Color="{StaticResource KNetSurfaceElevatedColor}" />
    <SolidColorBrush x:Key="KNetBorderBrush" Color="{StaticResource KNetBorderColor}" />
    <SolidColorBrush x:Key="KNetTextPrimaryBrush" Color="{StaticResource KNetTextPrimaryColor}" />
    <SolidColorBrush x:Key="KNetTextSecondaryBrush" Color="{StaticResource KNetTextSecondaryColor}" />
    <SolidColorBrush x:Key="KNetAccentBrush" Color="{StaticResource KNetAccentColor}" />
    <SolidColorBrush x:Key="KNetAccentMutedBrush" Color="{StaticResource KNetAccentMutedColor}" />
    <SolidColorBrush x:Key="KNetDangerBrush" Color="{StaticResource KNetDangerColor}" />

    <Style x:Key="KNetSectionLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource KNetTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
    </Style>

    <Style x:Key="KNetNavigationButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource KNetTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="10,7" />
    </Style>

    <Style x:Key="KNetIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource KNetTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="KNetPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource KNetAccentBrush}" />
        <Setter Property="Foreground" Value="#111318" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style x:Key="KNetSurfaceButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource KNetSurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KNetTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KNetBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,7" />
    </Style>
</ResourceDictionary>
