<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KNetAgent.Desktop.WinUI.Features.Operations.OperationsHubView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MaxWidth="1050">

    <TabView
        IsAddTabButtonVisible="False"
        TabWidthMode="Equal">
        <TabViewItem Header="VS Code Bridge" IsClosable="False">
            <ScrollViewer
                MaxHeight="650"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="4,16,4,8" Spacing="12">
                    <TextBlock Text="只读 VS Code Bridge" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock
                        Text="仅允许受信任的本地桌面 VS Code，并要求工作区根目录完全一致。配对密钥不会写入项目。"
                        TextWrapping="Wrap" />
                    <InfoBar
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="连接状态"
                        Message="{Binding VsCode.Status}" />
                    <TextBlock Text="本地命名管道" FontWeight="SemiBold" />
                    <TextBox
                        Text="{Binding VsCode.PairingPipeName}"
                        IsReadOnly="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="复制临时配对 JSON"
                            Command="{Binding VsCode.CopyPairingJsonCommand}" />
                        <Button Content="刷新状态" Command="{Binding VsCode.RefreshCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding VsCode.ClipboardStatus}" TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding VsCode.ClipboardCountdownLabel}"
                        FontSize="12"
                        Opacity="0.72" />
                    <TextBlock
                        Text="连接成功会立即清理仍然匹配的剪贴板内容；如果用户已经复制了其他内容，则绝不会清空。"
                        TextWrapping="Wrap"
                        FontSize="12"
                        Opacity="0.72" />
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

        <TabViewItem Header="后台任务" IsClosable="False">
            <ScrollViewer
                MaxHeight="650"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="4,16,4,8" Spacing="10">
                    <TextBlock Text="后台任务管理" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock
                        Text="查看持久化任务状态并按 cursor 增量读取输出。本页不提供 stdin 或交互式 Shell。"
                        TextWrapping="Wrap" />
                    <Button
                        Content="协调并刷新"
                        Command="{Binding BackgroundJobs.RefreshCommand}"
                        HorizontalAlignment="Left" />
                    <ListView
                        Height="180"
                        ItemsSource="{Binding BackgroundJobs.Jobs}"
                        SelectedItem="{Binding BackgroundJobs.SelectedJob, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4" Spacing="2">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding State}" FontSize="12" Opacity="0.75" />
                                    <TextBlock Text="{Binding Timing}" FontSize="11" Opacity="0.65" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="读取增量输出"
                            Command="{Binding BackgroundJobs.ReadMoreOutputCommand}" />
                        <TextBlock
                            Text="{Binding BackgroundJobs.OutputCursorLabel}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBox
                        Text="{Binding BackgroundJobs.Output}"
                        AcceptsReturn="True"
                        IsReadOnly="True"
                        TextWrapping="NoWrap"
                        FontFamily="Cascadia Mono, Consolas"
                        Height="190"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    <CheckBox
                        Content="我确认停止当前选中的活动任务"
                        IsChecked="{Binding BackgroundJobs.StopApproved, Mode=TwoWay}" />
                    <Button
                        Content="审批并停止"
                        Command="{Binding BackgroundJobs.StopCommand}"
                        HorizontalAlignment="Left" />
                    <InfoBar
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Message="{Binding BackgroundJobs.Status}" />
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

        <TabViewItem Header="受控自迭代" IsClosable="False">
            <ScrollViewer
                MaxHeight="650"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="4,16,4,8" Spacing="10">
                    <TextBlock Text="受控代码迭代" FontSize="18" FontWeight="SemiBold" />
                    <InfoBar
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Title="只在用户操作后运行"
                        Message="WinUI 自迭代当前安全禁用。临时副本不是低权限或无网络沙箱；在隔离验证器完成前，不会在审批 Diff 之前执行模型生成的构建或测试。" />
                    <TextBlock Text="K.netagent 源码工作区" FontWeight="SemiBold" />
                    <TextBox
                        Text="{Binding CodeIteration.SelfWorkspaceLabel}"
                        IsReadOnly="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox
                            MinWidth="300"
                            ItemsSource="{Binding CodeIteration.Guides}"
                            SelectedItem="{Binding CodeIteration.SelectedGuide, Mode=TwoWay}"
                            DisplayMemberPath="Title"
                            PlaceholderText="选择 iteration-guides 指引" />
                        <Button
                            Content="刷新指引"
                            Command="{Binding CodeIteration.RefreshGuidesCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="生成并验证"
                            Command="{Binding CodeIteration.GenerateAndValidateCommand}" />
                        <Button
                            Content="取消当前操作"
                            Command="{Binding CodeIteration.CancelCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding CodeIteration.ProposalSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CodeIteration.ProposalFingerprintLabel}" FontFamily="Cascadia Mono, Consolas" />
                    <Expander Header="完整文件 Diff" IsExpanded="True">
                        <TextBox
                            Text="{Binding CodeIteration.DiffPreview}"
                            AcceptsReturn="True"
                            IsReadOnly="True"
                            TextWrapping="NoWrap"
                            FontFamily="Cascadia Mono, Consolas"
                            Height="230"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </Expander>
                    <Expander Header="构建与测试输出">
                        <TextBox
                            Text="{Binding CodeIteration.ValidationOutput}"
                            AcceptsReturn="True"
                            IsReadOnly="True"
                            TextWrapping="NoWrap"
                            FontFamily="Cascadia Mono, Consolas"
                            Height="180"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </Expander>
                    <CheckBox
                        Content="我已审阅当前 hash 对应的完整 Diff，并批准 Apply"
                        IsChecked="{Binding CodeIteration.ApplyApproved, Mode=TwoWay}" />
                    <Button
                        Content="Apply（写入、重新验证，失败自动回滚）"
                        Command="{Binding CodeIteration.ApplyCommand}"
                        HorizontalAlignment="Left" />
                    <InfoBar
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Message="{Binding CodeIteration.Result}" />
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>
    </TabView>
</UserControl>
