<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KNetAgent.Desktop.WinUI.Features.WindowsEvents.EventCenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KNetAgent.Desktop.WinUI.Features.WindowsEvents">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid x:Name="LayoutRoot" Padding="20" RowSpacing="16" ColumnSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilterColumn" Width="*" />
                <ColumnDefinition x:Name="EventsColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="800" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="FilterColumn.Width" Value="230" />
                            <Setter Target="EventsColumn.Width" Value="*" />
                            <Setter Target="EventContent.(Grid.Row)" Value="1" />
                            <Setter Target="EventContent.(Grid.Column)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <StackPanel Grid.ColumnSpan="2" Spacing="6">
                <TextBlock Text="Windows 事件中心" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="在本地查看 Application / System 日志，勾选故障证据后再交给 Agent。" TextWrapping="Wrap" />
                <TextBlock Text="系统事件已经过自动脱敏，但仍可能含有敏感业务信息。请检查证据预览，再决定是否发送。" TextWrapping="Wrap" FontSize="12" Opacity="0.72" />
            </StackPanel>
            <Border Grid.Row="1" Padding="14" CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="本机日志" FontSize="16" FontWeight="SemiBold" />
                    <ComboBox Header="频道" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" IsEnabled="{Binding CanQuery}" />
                    <TextBox Header="最近多少分钟（1–10080）" Text="{Binding LookbackMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanQuery}" />
                    <ComboBox Header="级别" ItemsSource="{Binding Levels}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedLevel, Mode=TwoWay}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanQuery}" />
                    <TextBox Header="事件 ID（可选）" Text="{Binding EventIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanQuery}" />
                    <TextBox Header="来源 Provider（可选）" MaxLength="128" Text="{Binding Provider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanQuery}" />
                    <TextBox Header="结果上限（1–200）" Text="{Binding MaxEventsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanQuery}" />
                    <Button Content="查询历史事件" Command="{Binding QueryCommand}" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock Text="实时监控" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <Button Content="开始监听新事件" Command="{Binding StartWatchCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="从上次位置继续" Command="{Binding ResumeWatchCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="停止监控" Command="{Binding StopWatchCommand}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="继续操作会使用本机保存的位置；关闭本窗口会停止监听。" TextWrapping="Wrap" FontSize="12" Opacity="0.72" />
                    <TextBlock Text="当前支持 Application 和 System；更多 Windows 原生诊断能力后续接入。" TextWrapping="Wrap" FontSize="12" Opacity="0.72" />
                </StackPanel>
            </Border>
            <StackPanel x:Name="EventContent" Grid.Row="2" Grid.Column="0" Spacing="12">
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{Binding Status}" />
                <TextBlock Text="{Binding WatchStatus}" TextWrapping="Wrap" FontSize="12" />
                <TextBlock Text="{Binding SelectionLabel}" FontWeight="SemiBold" />
                <Border CornerRadius="10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <ListView ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                              SelectionMode="Single" Height="250" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:EventCenterRow">
                                <Grid ColumnSpacing="8" Padding="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="选择事件作为证据" MinWidth="24" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TimeLabel}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
                <Expander Header="故障线索 · 本地分组" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                        <Button Content="整理当前事件" Command="{Binding BuildIncidentsCommand}" />
                        <TextBlock Text="{Binding IncidentStatus}" TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding Incidents}" SelectedItem="{Binding SelectedIncident, Mode=TwoWay}"
                                  DisplayMemberPath="Title" HorizontalAlignment="Stretch" PlaceholderText="选择故障线索组" />
                        <TextBox Text="{Binding IncidentDetail, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" Height="220" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <Button Content="选中本组证据（最多 20 条）" Command="{Binding SelectIncidentEvidenceCommand}" />
                    </StackPanel>
                </Expander>
                <TextBlock Text="事件详情 · 已脱敏" FontWeight="SemiBold" />
                <TextBox Text="{Binding SelectedDetail, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="190" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="发送前的证据预览" FontWeight="SemiBold" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Content="预览所选证据" Command="{Binding PreviewEvidenceCommand}" HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Command="{Binding StageEvidenceCommand}" HorizontalAlignment="Stretch">
                        <TextBlock Text="加入聊天草稿" TextWrapping="Wrap" />
                    </Button>
                </Grid>
                <TextBlock Text="{Binding EvidenceStatus}" TextWrapping="Wrap" FontSize="12" />
                <TextBox Text="{Binding EvidencePreview, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="190" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PlaceholderText="只有手动勾选的事件会出现在这里。加入草稿不会自动发送。" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
