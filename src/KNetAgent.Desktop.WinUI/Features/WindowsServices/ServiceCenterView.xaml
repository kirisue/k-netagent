<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="KNetAgent.Desktop.WinUI.Features.WindowsServices.ServiceCenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid Padding="20" RowSpacing="14" ColumnSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FiltersColumn" Width="*"/><ColumnDefinition x:Name="ResultsColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Narrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers></VisualState>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="800"/></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="FiltersColumn.Width" Value="250"/><Setter Target="ResultsColumn.Width" Value="*"/>
                            <Setter Target="ResultsPanel.(Grid.Row)" Value="1"/><Setter Target="ResultsPanel.(Grid.Column)" Value="1"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <StackPanel Grid.ColumnSpan="2" Spacing="6">
                <TextBlock Text="Windows 服务状态" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="查看本机服务状态、启动类型与依赖，选中一项后可加入聊天草稿分析。" TextWrapping="Wrap"/>
                <TextBlock Text="只读快照，不启动、停止或修改服务。服务已停止不一定是故障。" TextWrapping="Wrap" Opacity="0.72"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="10">
                <TextBox Header="精确服务名（可选）" MaxLength="256" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanQuery}"/>
                <TextBox Header="名称 / 显示名筛选（可选）" MaxLength="128" Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanQuery}"/>
                <TextBlock Text="精确名称与模糊筛选只需填写一项；都留空时列出本机服务。" TextWrapping="Wrap" FontSize="12" Opacity="0.72"/>
                <TextBox Header="结果上限（1–100）" Text="{Binding MaxServices, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanQuery}"/>
                <Button Content="查询服务状态" Command="{Binding QueryCommand}" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"/>
                <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel x:Name="ResultsPanel" Grid.Row="2" Spacing="12">
                <ListView ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService, Mode=TwoWay}" SelectionMode="Single" Height="280" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4" Spacing="4">
                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Name}" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <TextBlock Text="{Binding SelectedDetail}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </Border>
                <TextBlock Text="准备加入聊天的脱敏证据" FontWeight="SemiBold"/>
                <Border Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <TextBlock Text="{Binding EvidencePreview}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </Border>
                <TextBlock Text="服务名称可能透露已安装的软件。请检查脱敏证据，再决定是否加入聊天。加入草稿不会自动发送。" TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
                <Button Content="将选中服务加入聊天草稿" Command="{Binding StageEvidenceCommand}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
